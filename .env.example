# Application
APP_NAME=ShopPilot 电商 Agent
APP_ENV=development
SECRET_KEY=change-me-before-production
DEMO_MODE=true
BASE_URL=http://localhost:8000

# Docker Compose infrastructure credentials
MYSQL_DATABASE=shop_pilot
MYSQL_USER=shoppilot
MYSQL_PASSWORD=replace-with-a-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

# SQLite is the zero-dependency local default. Docker Compose switches this to MySQL.
DATABASE_URL=sqlite:///./data/shop_pilot.db
# DATABASE_URL=mysql+pymysql://shoppilot:shoppilot@mysql:3306/shop_pilot?charset=utf8mb4

# Optional infrastructure. The app has safe local fallbacks when these are absent.
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Optional OpenAI-compatible LLM gateway. Without a key the demo uses a deterministic parser.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODELS=deepseek-chat,deepseek-reasoner

# Demo identity and guardrails
BUYER_TOKEN=
MERCHANT_TOKEN=
MAX_REQUEST_CENTS=200000
HIGH_VALUE_ORDER_CENTS=200000
APPROVAL_THRESHOLD_CENTS=500000
